#: darkadmin.php includes/settings-page.php
msgid "DarkAdmin"
msgstr "DarkAdmin"

#: includes/settings-page.php
msgid "Dark theme for the WordPress backend"
msgstr "Dunkles Theme für das WordPress-Backend"

#: darkadmin.php
msgid "Settings"
msgstr "Einstellungen"

#: includes/settings-page.php
msgid "Active"
msgstr "Aktiv"

#: includes/settings-page.php
msgid "Inactive"
msgstr "Inaktiv"

#: includes/settings-page.php
msgid "General"
msgstr "Allgemein"

#: includes/settings-page.php
msgid "Enable Dark Mode"
msgstr "Dark Mode aktivieren"

#: includes/settings-page.php
msgid "Enables the dark theme for all admin pages. Administrators always see dark mode when this is active."
msgstr "Aktiviert das dunkle Theme für alle Admin-Seiten. Administratoren sehen den Dark Mode immer, wenn diese Option aktiviert ist."

#: includes/settings-page.php
msgid "Auto Dark Mode"
msgstr "Auto Dark Mode"

#: includes/settings-page.php
msgid "Automatically darkens bright backgrounds and lightens dark text from unknown plugins. Requires Dark Mode to be active."
msgstr "Dunkelt helle Hintergründe unbekannter Plugins automatisch ab und hellt deren dunklen Text auf. Erfordert einen aktiven Dark Mode."

#: includes/settings-page.php
msgid "Dark Block Editor"
msgstr "Dunkler Block-Editor"

#: includes/settings-page.php
msgid "Applies dark mode to the block editor for posts and pages. The editing area turns dark when \"Use theme styles\" is turned off in the editor preferences, or when the theme has no editor styles."
msgstr "Wendet den Dark Mode auf den Block-Editor für Beiträge und Seiten an. Der Bearbeitungsbereich wird dunkel, wenn „Theme-Stile verwenden“ in den Editor-Einstellungen deaktiviert ist oder das Theme keine eigenen Editor-Stile hat."

#: includes/settings-page.php
msgid "Requires WordPress 7.1 or later."
msgstr "Erfordert WordPress 7.1 oder neuer."

#: includes/settings-page.php
msgid "Darken Theme Design in the Editor"
msgstr "Theme-Design im Editor abdunkeln"

#: includes/settings-page.php
msgid "Also darkens the editing area while \"Use theme styles\" is on. The editor then no longer shows your theme's real colors. Requires \"Dark Block Editor\"."
msgstr "Dunkelt den Bearbeitungsbereich auch ab, wenn „Theme-Stile verwenden“ aktiv ist. Der Editor zeigt dann nicht mehr die tatsächlichen Farben deines Themes. Erfordert „Dunkler Block-Editor“."

#: includes/settings-page.php
msgid "Preset Themes"
msgstr "Preset-Themes"

#: includes/settings-page.php
msgid "Choose a preset to load its color palette. You can further customize colors below after loading."
msgstr "Wähle ein Preset aus, um dessen Farbpalette zu laden. Die Farben kannst du anschließend weiter unten anpassen."

#: includes/settings-page.php
msgid "Modern"
msgstr "Modern"

#: includes/settings-page.php
msgid "WP 7.0 design language — default"
msgstr "Designsprache von WP 7.0 — Standard"

#: includes/settings-page.php
msgid "Classic"
msgstr "Klassisch"

#: includes/settings-page.php
msgid "WP 6.x dark theme"
msgstr "Dark-Theme von WP 6.x"

#: includes/settings-page.php
msgid "✓ Active"
msgstr "✓ Aktiv"

#: includes/settings-page.php
msgid "Load Preset"
msgstr "Preset laden"

#: includes/settings-page.php
msgid "Preview"
msgstr "Vorschau"

#: includes/settings-page.php
msgid "User Access"
msgstr "Benutzerzugriff"

#: includes/settings-page.php
msgid "All Users"
msgstr "Alle Benutzer"

#: includes/settings-page.php
msgid "Dark mode applies to everyone."
msgstr "Dark Mode gilt für alle Benutzer."

#: includes/settings-page.php
msgid "Include"
msgstr "Einschließen"

#: includes/settings-page.php
msgid "Only selected users get dark mode."
msgstr "Nur ausgewählte Benutzer erhalten den Dark Mode."

#: includes/settings-page.php
msgid "Exclude"
msgstr "Ausschließen"

#: includes/settings-page.php
msgid "Everyone except selected users gets dark mode."
msgstr "Alle außer den ausgewählten Benutzern erhalten den Dark Mode."

#: includes/settings-page.php
msgid "Administrators are not listed here — they always have dark mode active."
msgstr "Administratoren werden hier nicht angezeigt — sie haben den Dark Mode immer aktiv."

#: includes/settings-page.php
msgid "No non-administrator users found. Create additional users to manage their dark mode access here."
msgstr "Keine Benutzer ohne Administratorrechte gefunden. Erstelle weitere Benutzer, um deren Dark-Mode-Zugriff hier zu verwalten."

#: includes/settings-page.php
msgid "Plugins"
msgstr "Plugins"

#: includes/settings-page.php
msgid "Dark styles load automatically for installed plugins. Uncheck a plugin to disable its styles."
msgstr "Dunkle Stile werden automatisch für installierte Plugins geladen. Entferne den Haken bei einem Plugin, um dessen Stile zu deaktivieren."

#: includes/settings-page.php
msgid "Automatic"
msgstr "Automatisch"

#: includes/settings-page.php
msgid "Installed"
msgstr "Installiert"

#: includes/settings-page.php
msgid "Not installed"
msgstr "Nicht installiert"

#: includes/settings-page.php
msgid "Plugin styles load after the main dark theme and use your color variables."
msgstr "Plugin-Stile werden nach dem Haupt-Dark-Theme geladen und verwenden deine Farbvariablen."

#: includes/plugins.php
msgid "SEO settings, metaboxes and dashboard widgets."
msgstr "SEO-Einstellungen, Metaboxen und Dashboard-Widgets."

#: includes/plugins.php
msgid "Firewall, scan and security options pages."
msgstr "Seiten für Firewall, Scans und Sicherheitsoptionen."

#: includes/plugins.php
msgid "Backup, restore and migration screens."
msgstr "Sicherungs-, Wiederherstellungs- und Migrationsseiten."

#: includes/plugins.php
msgid "Database, cache and image optimization UI."
msgstr "Oberfläche für Datenbank-, Cache- und Bildoptimierung."

#: includes/plugins.php
msgid "Form editor, tag generator, integration and list table."
msgstr "Formular-Editor, Tag-Generator, Integration und Listentabelle."

#: includes/plugins.php
msgid "Cookie consent wizard, dashboard, settings, banner editor and data tables."
msgstr "Assistent für die Cookie-Einwilligung, Dashboard, Einstellungen, Banner-Editor und Datentabellen."

#: includes/plugins.php
msgid "Subscription, forms, newsletters and settings tabs."
msgstr "Abonnements, Formulare, Newsletter und Einstellungs-Tabs."

#: includes/plugins.php
msgid "Backups, schedules, storage and settings screens."
msgstr "Sicherungen, Zeitpläne, Speicherorte und Einstellungsseiten."

#: includes/plugins.php
msgid "Dashboard, blocks, popup builder and settings screens."
msgstr "Dashboard, Blöcke, Pop-up-Builder und Einstellungsseiten."

#: includes/plugins.php
msgid "WordPress AI & Connectors"
msgstr "WordPress KI & Konnektoren"

#: includes/plugins.php
msgid "Connectors, AI settings, connector approvals and request logs."
msgstr "Konnektoren, KI-Einstellungen, Konnektor-Genehmigungen und Anfrage-Protokolle."

#: includes/settings-page.php
msgid "Layout & Spacing"
msgstr "Layout & Abstände"

#: includes/settings-page.php
msgid "Adjust spacing, button sizes, border radii and shadow. px values only for size fields; shadow accepts any valid CSS box-shadow value."
msgstr "Passe Abstände, Button-Größen, Eckenradien und Schatten an. Größenfelder nur in px; Schatten akzeptiert jeden gültigen CSS-box-shadow-Wert."

#: includes/settings-page.php
msgid "Restore Preset Layout"
msgstr "Voreingestelltes Layout wiederherstellen"

#: includes/settings-page.php
msgid "Color Customization"
msgstr "Farbanpassung"

#: includes/settings-page.php
msgid "Customize every color token individually. Changes are previewed live."
msgstr "Passe jeden Farbwert individuell an. Änderungen werden sofort als Vorschau angezeigt."

#: includes/settings-page.php
msgid "Export Palette"
msgstr "Palette exportieren"

#: includes/settings-page.php
msgid "Import Palette"
msgstr "Palette importieren"

#: includes/settings-page.php
msgid "Restore Preset Colors"
msgstr "Voreingestellte Farben wiederherstellen"

#: includes/settings-page.php
msgid "Available CSS Variables"
msgstr "Verfügbare CSS-Variablen"

#: includes/settings-page.php
msgid "Click to copy"
msgstr "Zum Kopieren klicken"

#: includes/enqueue.php
msgid "Copied!"
msgstr "Kopiert!"

#: includes/enqueue.php
msgid "Palette imported successfully."
msgstr "Palette erfolgreich importiert."

#: includes/enqueue.php
msgid "Invalid JSON or color value."
msgstr "Ungültiges JSON oder ungültiger Farbwert."

#: includes/settings-page.php
msgid "Custom CSS"
msgstr "Individuelles CSS"

#: includes/settings-page.php
msgid "Add your own CSS here, loaded after the dark mode stylesheet. All CSS variables are available."
msgstr "Füge hier dein eigenes CSS hinzu, das nach dem Dark-Mode-Stylesheet geladen wird. Alle CSS-Variablen sind verfügbar."

#: includes/settings-page.php
msgid "Save Settings"
msgstr "Einstellungen speichern"

#: includes/settings-page.php
msgid "Advanced"
msgstr "Erweitert"

#: includes/settings-page.php
msgid "Excluded Pages"
msgstr "Ausgeschlossene Seiten"

#: includes/settings-page.php
msgid "One entry per line. Dark mode styles will not be loaded on matching admin pages."
msgstr "Ein Eintrag pro Zeile. Dark-Mode-Stile werden auf den entsprechenden Admin-Seiten nicht geladen."

#: includes/settings-page.php
msgid "Supports plain filenames (plugins.php) and custom page slugs (admin.php?page=my-plugin). Lines starting with # are treated as comments."
msgstr "Unterstützt einfache Dateinamen (plugins.php) und individuelle Seiten-Slugs (admin.php?page=my-plugin). Zeilen, die mit # beginnen, werden als Kommentare behandelt."

#. translators: 1: site editor filename, 2: comma-separated list of block editor filenames.
#: includes/settings-page.php
msgid "The site editor (%1$s) is excluded unless \"Dark Site Editor\" is enabled. The block editor (%2$s) is excluded unless \"Dark Block Editor\" is enabled."
msgstr "Der Website-Editor (%1$s) ist ausgeschlossen, solange „Dunkler Website-Editor“ nicht aktiviert ist. Der Block-Editor (%2$s) ist ausgeschlossen, solange „Dunkler Block-Editor“ nicht aktiviert ist."

#: includes/settings-page.php
msgid "You do not have sufficient permissions to access this page."
msgstr "Du verfügst nicht über ausreichende Berechtigungen, um auf diese Seite zuzugreifen."

#: darkadmin.php
msgid "✓ Dark Mode is active. Settings have been saved."
msgstr "✓ Dark Mode ist aktiv. Die Einstellungen wurden gespeichert."

#: darkadmin.php
msgid "✓ Settings saved. Dark Mode is disabled."
msgstr "✓ Einstellungen gespeichert. Dark Mode ist deaktiviert."

