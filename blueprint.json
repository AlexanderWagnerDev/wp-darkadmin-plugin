{
    "$schema": "https://playground.wordpress.net/blueprint-schema.json",
    "landingPage": "/wp-admin/options-general.php?page=darkadmin",
    "preferredVersions": {
        "php": "8.5",
        "wp": "latest"
    },
    "steps": [
        {
            "step": "login",
            "username": "admin",
            "password": "password"
        },
        {
            "step": "installPlugin",
            "pluginData": {
                "resource": "wordpress.org/plugins",
                "slug": "darkadmin-dark-mode-for-adminpanel"
            },
            "options": {
                "activate": true
            }
        },
        {
            "step": "setSiteLanguage",
            "language": "browser"
        },
        {
            "step": "setSiteOptions",
            "options": {
                "darkadmin_dark_mode_enabled": "1",
                "darkadmin_auto_darken": "0",
                "darkadmin_block_editor": "1",
                "darkadmin_block_editor_theme": "1",
                "darkadmin_site_editor": "1",
                "darkadmin_login_page": "1",
                "darkadmin_user_access_mode": "all",
                "darkadmin_preset": "modern"
            }
        }
    ]
}
